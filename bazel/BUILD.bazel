"""Public Bazel macros and hermetic source-generator tools."""

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "host_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "host_linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "host_macos_x86_64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "host_macos_aarch64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "host_windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "host_windows_aarch64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

alias(
    name = "bun",
    actual = select({
        ":host_linux_x86_64": "@openkache_bun_linux_x86_64//:bun",
        ":host_linux_aarch64": "@openkache_bun_linux_aarch64//:bun",
        ":host_macos_x86_64": "@openkache_bun_darwin_x86_64//:bun",
        ":host_macos_aarch64": "@openkache_bun_darwin_aarch64//:bun",
        ":host_windows_x86_64": "@openkache_bun_windows_x86_64//:bun.exe",
        ":host_windows_aarch64": "@openkache_bun_windows_aarch64//:bun.exe",
    }),
)

alias(
    name = "smithy",
    actual = select({
        ":host_linux_x86_64": "@openkache_smithy_linux_x86_64//:bin/smithy",
        ":host_linux_aarch64": "@openkache_smithy_linux_aarch64//:bin/smithy",
        ":host_macos_x86_64": "@openkache_smithy_darwin_x86_64//:bin/smithy",
        ":host_macos_aarch64": "@openkache_smithy_darwin_aarch64//:bin/smithy",
        ":host_windows_x86_64": "@openkache_smithy_windows_x86_64//:bin/smithy.bat",
    }),
)

filegroup(
    name = "smithy_tree",
    srcs = select({
        ":host_linux_x86_64": ["@openkache_smithy_linux_x86_64//:all_files"],
        ":host_linux_aarch64": ["@openkache_smithy_linux_aarch64//:all_files"],
        ":host_macos_x86_64": ["@openkache_smithy_darwin_x86_64//:all_files"],
        ":host_macos_aarch64": ["@openkache_smithy_darwin_aarch64//:all_files"],
        ":host_windows_x86_64": ["@openkache_smithy_windows_x86_64//:all_files"],
    }),
)

filegroup(
    name = "generator_tools",
    srcs = [
        ":bun",
        ":smithy",
        ":smithy_tree",
    ],
)

exports_files([
    "openkache_defs.bzl",
    "rules_dotnet_invariant.patch",
    "rules_swift_gcc.patch",
])
