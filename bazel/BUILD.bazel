"""Hermetic generator tools for the initial Linux Bazel graph."""

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "host_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "host_linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

alias(
    name = "bun",
    actual = select({
        ":host_linux_x86_64": "@openkache_bun_linux_x86_64//:bun",
        ":host_linux_aarch64": "@openkache_bun_linux_aarch64//:bun",
    }),
)

alias(
    name = "smithy",
    actual = select({
        ":host_linux_x86_64": "@openkache_smithy_linux_x86_64//:bin/smithy",
        ":host_linux_aarch64": "@openkache_smithy_linux_aarch64//:bin/smithy",
    }),
)

filegroup(
    name = "smithy_tree",
    srcs = select({
        ":host_linux_x86_64": ["@openkache_smithy_linux_x86_64//:all_files"],
        ":host_linux_aarch64": ["@openkache_smithy_linux_aarch64//:all_files"],
    }),
)

exports_files([
    "glommio-musl.patch",
    "openkache_defs.bzl",
    "snmalloc-sys-musl-runtime.patch",
])
