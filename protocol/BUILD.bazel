"""Bazel targets for the public wire-protocol crate."""

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")
load(
    "//bazel:openkache_defs.bzl",
    "RUST_EDITION",
    "cargo_deps",
    "crate_aliases",
    "rust_metadata",
)

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "generator_inputs",
    srcs = [
        "compat_v1_types.ts",
        "compatibility_v1_layout.ts",
        "compatibility_v1_renderer.ts",
        "generate.ts",
        "compatibility_v1.ts",
        "wire_descriptor.ts",
        "wire/extract_contract.ts",
        "wire/extract_contract_operations.ts",
        "wire/extract_contract_request_wire.ts",
        "wire/extract_contract_shapes.ts",
        "wire/index.ts",
        "wire/render_rust_contract.ts",
        "wire/render_rust_server.ts",
        "wire/smithy_ast.ts",
        "wire/validate_v1_contract.ts",
        "wire/validate_contract.ts",
        "wire.ts",
        "wire_layout.ts",
        "wire_spec.ts",
        "wire_types.ts",
    ] + glob([
        "model/**",
    ]),
)

filegroup(
    name = "runtime_sources",
    srcs = [
        "Cargo.toml",
        "README.md",
        "build.rs",
        "compat_v1_types.ts",
        "compatibility_v1_layout.ts",
        "compatibility_v1_renderer.ts",
        "generate.ts",
        "compatibility_v1.ts",
        "wire_descriptor.ts",
        "wire/extract_contract.ts",
        "wire/extract_contract_operations.ts",
        "wire/extract_contract_request_wire.ts",
        "wire/extract_contract_shapes.ts",
        "wire/index.ts",
        "wire/render_rust_contract.ts",
        "wire/render_rust_server.ts",
        "wire/smithy_ast.ts",
        "wire/validate_v1_contract.ts",
        "wire/validate_contract.ts",
        "wire.ts",
        "wire_layout.ts",
        "wire_spec.ts",
        "wire_types.ts",
    ] + glob([
        "model/**",
        "src/**",
    ]),
)

cargo_build_script(
    name = "openkache_protocol_build_script",
    srcs = ["build.rs"],
    build_script_env = {
        "OPENKACHE_BUN_EXECUTABLE": "$(execpath //bazel:bun)",
        "OPENKACHE_SMITHY_EXECUTABLE": "$(execpath //bazel:smithy)",
        "OPENKACHE_SMITHY_USE_SHELL": "1",
    },
    crate_name = "openkache_protocol_build_script",
    crate_root = "build.rs",
    data = [":generator_inputs"],
    edition = RUST_EDITION,
    tools = [
        "//bazel:bun",
        "//bazel:smithy",
        "//bazel:smithy_tree",
    ],
)

rust_library(
    name = "openkache_protocol",
    srcs = [
        "src/compat_v1.rs",
        "src/codec.rs",
        "src/lib.rs",
        "src/layout.rs",
        "src/optional_values.rs",
        "src/request.rs",
        "src/response.rs",
    ],
    aliases = crate_aliases("protocol"),
    crate_name = "openkache_protocol",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    rustc_env = rust_metadata("openkache-protocol"),
    deps = [":openkache_protocol_build_script"] + cargo_deps("protocol"),
)
