# Keep Bazel's install/repository/action caches outside a worktree. The `~`
# form is expanded by Bazel, so equivalent worktrees on one developer machine
# share downloads and action results without embedding a machine-specific path.
startup --output_user_root=~/.cache/openkache/bazel/output-user-root
common --repository_cache=~/.cache/openkache/bazel/repository-cache

# rules_rust already remaps execroot/output paths before invoking rustc. A
# shared disk cache can therefore reuse compiled artifacts when two worktrees
# contain the same inputs even though their checkout paths differ.
build --disk_cache=~/.cache/openkache/bazel/action-cache
test --disk_cache=~/.cache/openkache/bazel/action-cache
run --disk_cache=~/.cache/openkache/bazel/action-cache
