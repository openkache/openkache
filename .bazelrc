# Bound the Bazel client daemon so parallel public worktrees do not retain
# host-sized heaps or stay alive indefinitely after an agent session ends.
startup --max_idle_secs=300
startup --shutdown_on_low_sys_mem
startup --host_jvm_args=-Xms256m
startup --host_jvm_args=-Xmx1024m
startup --host_jvm_args=-XX:ActiveProcessorCount=2

# Keep Bazel's install/repository/action caches outside a worktree. The `~`
# form is expanded by Bazel, so equivalent checkouts share downloads and
# action results without embedding a machine-specific path.
startup --output_user_root=~/.cache/openkache/bazel/output-user-root
common --repository_cache=~/.cache/openkache/bazel/repository-cache

# Keep each Bazel invocation inside a conservative 32 GiB memory budget. The
# sandbox and worker limits apply where the host supports Bazel's resource
# controls, while the scheduler settings still bound ordinary local actions.
# These are per-invocation limits; override them explicitly on larger hosts.
build --jobs=8
build --local_resources=cpu=8
build --local_resources=memory=32768
build --local_ram_resources=32768
build --experimental_sandbox_memory_limit_mb=3072
build --experimental_worker_memory_limit_mb=2048
build --experimental_total_worker_memory_limit_mb=2048
test --jobs=8
test --local_resources=cpu=8
test --local_resources=memory=32768
test --local_ram_resources=32768
test --local_test_jobs=1
test --experimental_sandbox_memory_limit_mb=3072
test --experimental_worker_memory_limit_mb=2048
test --experimental_total_worker_memory_limit_mb=2048
run --jobs=8
run --local_resources=cpu=8
run --local_resources=memory=32768
run --local_ram_resources=32768
run --experimental_sandbox_memory_limit_mb=3072
run --experimental_worker_memory_limit_mb=2048
run --experimental_total_worker_memory_limit_mb=2048

# Optional profile for a local NativeLink-compatible Remote Execution
# endpoint. Enable it with `--config=local-remote` when the endpoint is
# available; disabled fallback keeps a misconfigured profile from silently
# consuming a separate local resource budget.
build:local-remote --remote_executor=grpc://127.0.0.1:8980
build:local-remote --remote_cache=grpc://127.0.0.1:8980
build:local-remote --remote_instance_name=openkache
build:local-remote --remote_download_outputs=all
build:local-remote --remote_local_fallback=false
build:local-remote --remote_timeout=60s
test:local-remote --remote_executor=grpc://127.0.0.1:8980
test:local-remote --remote_cache=grpc://127.0.0.1:8980
test:local-remote --remote_instance_name=openkache
test:local-remote --remote_download_outputs=all
test:local-remote --remote_local_fallback=false
test:local-remote --remote_timeout=60s
run:local-remote --remote_executor=grpc://127.0.0.1:8980
run:local-remote --remote_cache=grpc://127.0.0.1:8980
run:local-remote --remote_instance_name=openkache
run:local-remote --remote_download_outputs=all
run:local-remote --remote_local_fallback=false
run:local-remote --remote_timeout=60s

build --disk_cache=~/.cache/openkache/bazel/action-cache
test --disk_cache=~/.cache/openkache/bazel/action-cache
run --disk_cache=~/.cache/openkache/bazel/action-cache
