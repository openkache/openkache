"""Bazel target for the public OpenKache server binary."""

load("@rules_rust//rust:defs.bzl", "rust_binary")
load(
    "//bazel:openkache_defs.bzl",
    "RUST_EDITION",
    "cargo_deps",
    "crate_aliases",
    "rust_metadata",
)

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "server_source_tree",
    srcs = [
        "Cargo.toml",
        "README.md",
    ] + glob(["src/**/*.rs"]),
)

filegroup(
    name = "runtime_sources",
    srcs = [":server_source_tree"],
)

rust_binary(
    name = "openkache_server_bin",
    srcs = glob(["src/**/*.rs"]),
    aliases = crate_aliases("server"),
    crate_name = "openkache_server",
    crate_root = "src/main.rs",
    edition = RUST_EDITION,
    rustc_env = rust_metadata("openkache-server"),
    deps = cargo_deps("server"),
)

alias(
    name = "openkache_server",
    actual = ":openkache_server_bin",
)
