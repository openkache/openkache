"""Bazel target for the public Python ctypes adapter."""

load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load(
    "//bazel:openkache_defs.bzl",
    "crate_aliases",
    "normal_cargo_deps",
    "rust_metadata",
)

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source_tree",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
    ] + glob(["src/**"]),
)

filegroup(
    name = "runtime_sources",
    srcs = [":source_tree"],
)

rust_shared_library(
    name = "openkache_client_python_native",
    srcs = glob(["src/**/*.rs"]),
    aliases = crate_aliases("clients/core"),
    crate_name = "openkache_client_python_native",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = rust_metadata("openkache-client-python-native"),
    deps = [
        "//clients/core:openkache_client_core_ffi_library",
    ] + normal_cargo_deps("clients/core"),
)
