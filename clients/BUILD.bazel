"""Shared source and generator inputs for the public Rust clients."""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "client_generator",
    srcs = glob([
        "generator/**",
    ]) + [
        "client_contract.ts",
        "api_shape_renderers.ts",
        "generate.ts",
        "generator_names.ts",
        "generator_values.ts",
        "compatibility_ffi_adapters.ts",
        "compatibility_request_adapters.ts",
        "compatibility_response_adapters.ts",
        "compatibility_result_projections.ts",
        "native_abi_renderers.ts",
        "operation_client_projection.ts",
        "operation_models.ts",
        "operation_plans.ts",
        "operation_results.ts",
    ],
)

filegroup(
    name = "client_generator_inputs",
    srcs = glob([
        "model/**",
    ]) + [
        ":client_generator",
        "//protocol:generator_inputs",
    ],
)

filegroup(
    name = "client_core_sources",
    srcs = ["//clients/core:source_tree"],
)

filegroup(
    name = "client_rust_sources",
    srcs = ["//clients/rust:source_tree"],
)

filegroup(
    name = "client_cli_sources",
    srcs = ["//clients/cli:source_tree"],
)

filegroup(
    name = "client_typescript_native_sources",
    srcs = ["//clients/typescript/native:source_tree"],
)

filegroup(
    name = "client_python_native_sources",
    srcs = ["//clients/python/native:source_tree"],
)

filegroup(
    name = "client_dotnet_sources",
    srcs = ["//clients/dotnet/OpenKache:source_tree"],
)

filegroup(
    name = "client_native_sources",
    srcs = [
        ":client_dotnet_sources",
        ":client_python_native_sources",
        ":client_typescript_native_sources",
    ],
)

filegroup(
    name = "client_source_tree",
    srcs = [
        ":client_cli_sources",
        ":client_core_sources",
        ":client_rust_sources",
    ],
)

# Keep the non-Rust client adapters and their package metadata available to
# Bazel consumers without copying generated distributions or build outputs.
filegroup(
    name = "language_client_sources",
    srcs = glob(
        [
            "c/**",
            "cpp/**",
            "dart/**",
            "dotnet/**",
            "go/**",
            "java/**",
            "kotlin/**",
            "python/**",
            "swift/**",
            "typescript/**",
        ],
        exclude = [
            "**/.build/**",
            "**/.dart_tool/**",
            "**/.direnv/**",
            "**/.gradle/**",
            "**/*.local.*",
            "**/.swiftpm/**",
            "**/__pycache__/**",
            "**/*.dylib",
            "**/*.dll",
            "**/*.egg-info/**",
            "**/*.pyd",
            "**/*.pyc",
            "**/*.pyo",
            "**/*.so",
            "**/Generated/**",
            "**/*_local/**",
            "**/build/**",
            "**/bin/**",
            "**/dist/**",
            "**/generated/**",
            "**/generated_local/**",
            "**/node_modules/**",
            "**/obj/**",
            "**/papers/**",
            "**/target/**",
            "**/_generated/**",
            "**/smithy_api.go",
            "**/smithy_contract.go",
            "**/smithy_operations.go",
        ],
    ) + [
        # This package facade is handwritten; generated Smithy modules in the
        # same directory remain excluded above.
        "python/src/openkache/_generated/__init__.py",
    ],
)

# Keep this stable name for private integration graphs that consume the
# language-facing source surface without depending on package internals.
alias(
    name = "client_language_sources",
    actual = ":language_client_sources",
)

filegroup(
    name = "runtime_sources",
    srcs = [
        "CLIENT.md",
        "README.md",
        ":client_generator_inputs",
        ":client_native_sources",
        ":client_source_tree",
        ":language_client_sources",
        "//clients/cli:README.md",
        "//clients/cli:runtime_sources",
        "//clients/core:README.md",
        "//clients/core:runtime_sources",
        "//clients/rust:README.md",
        "//clients/rust:runtime_sources",
    ],
)

filegroup(
    name = "native_adapter_artifacts",
    srcs = [
        "//clients/core:openkache_client_core_ffi",
        "//clients/python/native:openkache_client_python_native",
        "//clients/typescript/native:openkache_client_typescript_native",
    ],
)
