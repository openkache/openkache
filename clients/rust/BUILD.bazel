"""Bazel targets for the ergonomic public Rust client."""

load("@rules_rust//rust:defs.bzl", "rust_library")
load(
    "//bazel:openkache_defs.bzl",
    "RUST_EDITION",
    "cargo_deps",
    "crate_aliases",
    "rust_metadata",
)

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source_tree",
    srcs = [
        "Cargo.toml",
        "README.md",
        "LICENSE",
    ] + glob([
        "examples/**",
        "src/**",
    ]),
)

filegroup(
    name = "runtime_sources",
    srcs = [":source_tree"],
)

rust_library(
    name = "openkache_client",
    srcs = glob(["src/**/*.rs"], exclude = ["src/contract_snapshot/**"]),
    aliases = crate_aliases("clients/rust"),
    crate_features = [
        "quic-compio",
        "quic-quinn",
    ],
    crate_name = "openkache",
    crate_root = "src/lib.rs",
    compile_data = ["README.md"],
    edition = RUST_EDITION,
    rustc_env = rust_metadata("openkache"),
    deps = cargo_deps("clients/rust"),
)
