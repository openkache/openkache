<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>OpenKache</PackageId>
    <Version>0.1.0</Version>
    <Authors>OpenKache Team</Authors>
    <Description>Managed OpenKache client adapter over the shared Rust core</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://openkache.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openkache/openkache</RepositoryUrl>
    <PackageTags>cache;openkache;ssd;redis;kv;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="generated_local/**/*.cs" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="GenerateSmithyContract" BeforeTargets="CoreCompile">
    <Exec
      Command="bun &quot;$(MSBuildThisFileDirectory)../../generate.ts&quot;"
      EnvironmentVariables="OPENKACHE_GENERATION_TARGET=dotnet"
    />
    <ItemGroup>
      <Compile Include="generated_local/**/*.cs" />
    </ItemGroup>
  </Target>
</Project>
