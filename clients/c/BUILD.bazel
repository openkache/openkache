"""Bazel target for the public C header adapter."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "openkache_client_c",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    deps = ["//clients/core:openkache_client_core_headers"],
)

alias(
    name = "client_c",
    actual = ":openkache_client_c",
)
