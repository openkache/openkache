"""Bazel target for the public TypeScript Node-API adapter."""

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load(
    "//bazel:openkache_defs.bzl",
    "crate_aliases",
    "normal_cargo_deps",
    "proc_macro_deps",
    "rust_metadata",
)

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source_tree",
    srcs = glob([
        "Cargo.toml",
        "build.rs",
        "src/**",
    ]),
)

cargo_build_script(
    name = "openkache_client_napi_build_script",
    srcs = ["build.rs"],
    crate_name = "openkache_client_napi_build_script",
    crate_root = "build.rs",
    data = ["Cargo.toml"],
    edition = "2024",
)

# The Node-API ABI is a shared library whose extension is staged as `.node`
# by the package build. Keeping the Rust output under its crate name lets
# Bazel and NativeLink cache the compile/link action independently of staging.
rust_shared_library(
    name = "openkache_client_napi",
    srcs = glob(["src/**/*.rs"]),
    aliases = crate_aliases("clients/typescript/native"),
    crate_name = "openkache_client_napi",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = proc_macro_deps("clients/typescript/native"),
    rustc_env = rust_metadata("openkache-client-napi"),
    deps = [
        ":openkache_client_napi_build_script",
        "//clients/core:openkache_client_core",
    ] + normal_cargo_deps("clients/typescript/native"),
)
