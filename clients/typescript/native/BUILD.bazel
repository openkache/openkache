"""Bazel target for the public Node-API adapter."""

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load(
    "//bazel:openkache_defs.bzl",
    "RUST_EDITION",
    "build_deps",
    "crate_aliases",
    "normal_cargo_deps",
    "proc_macro_deps",
    "rust_metadata",
)

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "source_tree",
    srcs = [
        "Cargo.toml",
        "build.rs",
    ] + glob([
        "src/**",
    ]),
)

filegroup(
    name = "runtime_sources",
    srcs = [":source_tree"],
)

cargo_build_script(
    name = "openkache_client_typescript_native_build_script",
    srcs = ["build.rs"],
    crate_name = "openkache_client_typescript_native_build_script",
    crate_root = "build.rs",
    data = ["Cargo.toml"],
    edition = RUST_EDITION,
    deps = build_deps("clients/typescript/native"),
)

rust_shared_library(
    name = "openkache_client_typescript_native",
    srcs = glob(["src/**/*.rs"]),
    aliases = crate_aliases("clients/typescript/native"),
    crate_name = "openkache_client_napi",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    proc_macro_deps = proc_macro_deps("clients/typescript/native"),
    rustc_env = rust_metadata("openkache-client-napi"),
    deps = [
        ":openkache_client_typescript_native_build_script",
        "//clients/core:openkache_client_core",
    ] + normal_cargo_deps("clients/typescript/native"),
)
