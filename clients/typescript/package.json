{
  "name": "@openkache/client",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "description": "Promise-based OpenKache client for Node.js, Bun, and Deno with a runtime-neutral structured-value codec.",
  "keywords": [
    "bun",
    "cache",
    "deno",
    "node",
    "openkache"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openkache/openkache.git",
    "directory": "clients/typescript"
  },
  "bugs": "https://github.com/openkache/openkache/issues",
  "homepage": "https://github.com/openkache/openkache/tree/main/clients/typescript#readme",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./value-codec": {
      "types": "./dist/value-codec.d.ts",
      "import": "./dist/value-codec.js"
    }
  },
  "files": [
    "dist",
    "target/native/openkache-client.darwin-arm64.node",
    "target/native/openkache-client.linux-arm64-gnu.node",
    "target/native/openkache-client.linux-x64-gnu.node",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "./scripts/build-typescript.ts",
    "build:native": "./scripts/build-native.ts",
    "build:package": "bun run build && bun run build:native",
    "pack:check": "bun run build:package && bun pm pack --dry-run",
    "prepublishOnly": "bun run build:package",
    "typecheck": "bun run typecheck:node && bun run typecheck:browser",
    "typecheck:browser": "bun ./node_modules/typescript/bin/tsc --project tsconfig.browser.json",
    "typecheck:node": "bun ./node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
    "release:verify": "bun pm pack --dry-run && bun run scripts/check-publish.ts",
    "release:check": "bun run build:package && bun run release:verify",
    "release:dry-run": "bun run release:check && bun publish --dry-run --access public --tag latest --ignore-scripts",
    "release:publish": "bun run scripts/publish-typescript.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
