{
  "name": "@openkache/client",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./value-codec": {
      "types": "./dist/value-codec.d.ts",
      "import": "./dist/value-codec.js"
    }
  },
  "files": [
    "dist",
    "target/native/x86_64-unknown-linux-musl/release/openkache-client-helper",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ./node_modules/typescript/bin/tsc --project tsconfig.json",
    "build:native": "cargo zigbuild --locked --manifest-path ../rust/Cargo.toml --bin openkache-client-helper --release --target x86_64-unknown-linux-musl --target-dir target/native",
    "build:package": "bun run build && bun run build:native",
    "pack:check": "bun run build:package && bun pm pack --dry-run",
    "prepublishOnly": "bun run build:package",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "typescript": "^7.0.2"
  }
}
