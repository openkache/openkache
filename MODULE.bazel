    name = "openkache_bun_linux_x86_64",
    build_file_content = """exports_files(["bun"], visibility = ["//visibility:public"])""",
    sha256 = "79c0771fa8b92c33aae41e15a0e0d307ea99d0e2f00317c71c6c53237a78e25a",
    strip_prefix = "bun-linux-x64",
