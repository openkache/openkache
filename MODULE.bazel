"""Minimal Bazel module for the public Rust protocol and server graph."""

module(
    name = "openkache_public",
    version = "0.1.0",
)

_http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "platforms", version = "1.1.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [],
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = False,
)
# Keep optional server feature variants available to the Bazel graph. Cargo's
# default workspace selection omits these crates even though the locked
# production feature matrix references them.
crate.spec(package = "boring", version = "4.22.0")
crate.spec(package = "event-listener", version = "5.4.2")
crate.spec(package = "flume", version = "0.12.0")
crate.spec(package = "kanal", version = "0.1.1")
crate.spec(
    default_features = False,
    package = "kimojio",
    version = "0.17.0",
)
crate.spec(package = "glommio", version = "0.9.0")
crate.spec(package = "mimalloc", version = "0.1.52")
crate.spec(
    default_features = False,
    features = ["async-cancel", "iouring", "sync"],
    package = "monoio",
    version = "0.2.4",
)
crate.spec(
    default_features = False,
    features = ["boringssl-boring-crate"],
    package = "quiche",
    version = "0.29.3",
)
crate.spec(
    default_features = False,
    features = ["io_uring"],
    package = "rustix",
    version = "1.1.4",
)
crate.spec(package = "signal-hook", version = "0.4.4")
crate.spec(
    default_features = False,
    features = ["build_cc", "usewait-on-address"],
    package = "snmalloc-rs",
    version = "0.7.4",
)
crate.annotation(
    crate = "snmalloc-sys",
    version = "0.7.4",
    patch_args = ["-p1"],
    patches = ["//:bazel/snmalloc-sys-musl-runtime.patch"],
)
use_repo(crate, "crates")

# glommio's vendored liburing declarations use `cpu_set_t`, which musl only
# exposes when GNU extensions are enabled. Keep the build-script environment
# explicit so the Bazel musl graph matches Cargo's Linux build.
crate.annotation(
    crate = "glommio",
    version = "0.9.0",
    build_script_env = {
        "CFLAGS": "-D_GNU_SOURCE -U_FORTIFY_SOURCE",
    },
    patch_args = ["-p1"],
    patches = ["//:bazel/glommio-musl.patch"],
)

# Bazel's musl target does not synthesize Cargo's unstable libc cfg
# environment variable. libc's build script needs it to expose the Linux
# statx ABI consumed by Monoio.
crate.annotation(
    crate = "libc",
    version = "0.2.189",
    build_script_env = {
        "CARGO_CFG_LIBC_UNSTABLE_MUSL_V1_2_3": "1",
    },
)

# The protocol build script invokes the checked-in Bun/Smithy generators.
# Archives are fetched lazily for the selected host platform.
