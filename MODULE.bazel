# TypeScript's compiler and Node's ambient declarations are package inputs,
# not host tools. Keep the small npm archives pinned so a TypeScript package
# build works from a clean checkout without `bun install`.
_http_archive(
    name = "openkache_typescript_compiler",
    build_file_content = """exports_files(["bin/tsc"], visibility = ["//visibility:public"])""",
    sha256 = "da2513f4b95176d6dde8b51aab7afe8a927656c9d277369793f77f7e59371c08",
    strip_prefix = "package",
    urls = ["https://registry.npmjs.org/typescript/-/typescript-7.0.2.tgz"],
)

_http_archive(
    name = "openkache_node_types",
    build_file_content = """exports_files(["index.d.ts"], visibility = ["//visibility:public"])
filegroup(name = "all", srcs = glob(["**"], allow_empty = False), visibility = ["//visibility:public"])""",
    sha256 = "14200e662b222ab262da7ac16f60565f353a8be6ddc98d9d34b1a97e66c5bebc",
    strip_prefix = "node v24.13",
