"""Standalone Bazel module for OpenKache's public production workspace."""

module(
    name = "openkache_public",
    version = "0.1.0",
)

_http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_cc", version = "0.2.8")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_kotlin", version = "2.2.0")
bazel_dep(name = "rules_dart", version = "0.2.0")
bazel_dep(name = "rules_dotnet", version = "0.0.0")
bazel_dep(name = "rules_swift", version = "2.0.0")

# rules_dotnet is not published to the Bazel Central Registry yet. Keep the
# release archive pinned until it is, while using its native SDK toolchain
# rather than the developer's dotnet installation.
archive_override(
    module_name = "rules_dotnet",
    integrity = "sha256-DxGbnvsEDjWDJzRaV6FouiwMK0HHJIllKehhV44hLl8=",
    patch_strip = 1,
    patches = ["//bazel:rules_dotnet_invariant.patch"],
    strip_prefix = "rules_dotnet-0.22.1",
    urls = ["https://github.com/bazel-contrib/rules_dotnet/archive/refs/tags/v0.22.1.tar.gz"],
)

archive_override(
    module_name = "rules_swift",
    integrity = "sha256-Mu607zPHCNnJpO4PqEdTIu8UnavIGITdw7UOsu//eEM=",
    patch_strip = 1,
    patches = ["//bazel:rules_swift_gcc.patch"],
    strip_prefix = "",
    urls = ["https://github.com/bazelbuild/rules_swift/releases/download/2.0.0/rules_swift.2.0.0.tar.gz"],
)

# The public module owns the language compiler SDKs as well as the Rust graph.
# This keeps adapter builds independent from Cargo, Maven, Gradle, pub, and
# developer-installed Go/Kotlin/Dart binaries.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    go_mod = "//clients/go:go.mod",
)
use_repo(go_sdk, "go_toolchains")

register_toolchains("@go_toolchains//:all")

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(
    dotnet_version = "8.0.422",
)
use_repo(dotnet, "dotnet_toolchains")

register_toolchains("@dotnet_toolchains//:all")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.toml"],
    # Cargo owns the public workspace lockfile; Bazel must not rewrite it.
    skip_cargo_lockfile_overwrite = True,
)
use_repo(crate, "crates")

# The Smithy generators are part of the production source graph. Download
# pinned, self-contained Bun and Smithy CLI archives instead of inheriting PATH
# from Nix, Cargo, or a developer shell. Each archive is fetched lazily only
# when its host platform is selected by //bazel:generator_tools.
