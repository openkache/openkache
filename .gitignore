.direnv/

*.local.*
*_local/

# Rust output
target/

# Managed client output
clients/dotnet/**/bin/
clients/dotnet/**/obj/
clients/dart/lib/generated_contract.dart
clients/go/smithy_api.go
clients/go/smithy_contract.go
clients/java/src/main/java/io/openkache/client/generated/*.java
clients/kotlin/src/main/kotlin/io/openkache/client/generated/*.kt

# Python Smithy output is generated by package builds and release CI.
# Keep the handwritten package re-export module tracked.
clients/python/src/openkache/_generated/*.py
!clients/python/src/openkache/_generated/__init__.py

# Swift Smithy output is generated by the SwiftPM build plugin.
clients/swift/Sources/OpenKache/Generated/

# Local research papers
papers/
