.direnv/

# Bazel convenience symlinks generated in the workspace.
/bazel-*

*.local.*
*_local/

# Rust output
target/

# Public release-tool dependencies are installed locally by Bun.
scripts/node_modules/

# Third-party notices are generated into package staging directories.
**/THIRD-PARTY-NOTICES.txt

# Managed client output
clients/dotnet/**/bin/
clients/dotnet/**/obj/

# Python Smithy output is generated by package builds and release CI. Keep the
# handwritten package facade tracked while excluding generated modules.
clients/python/src/openkache/_generated/smithy_*.py

# Swift Smithy output is generated by the SwiftPM build plugin.
clients/swift/Sources/OpenKache/Generated/

# Go Smithy output is generated by `go generate` for module consumers.
clients/go/smithy_api.go
clients/go/smithy_contract.go
clients/go/smithy_operations.go

# Local research papers
papers/
