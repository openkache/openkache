# my.cnf for kvbench point-select benchmark -- CANONICAL MySQL 8.4.x, unprivileged.
# Absolute paths hardcoded for serveroptima1 (user kimseojin111).
# start.sh / session.sh also pass --basedir explicitly (resolves nix store path).
# THE BOX: mysqld pinned to cores 0,1 + cgroup memory.max=1G (page cache included).

[client]
port     = 33061
socket   = /home/kimseojin111/.bench/mysqldata/mysqld.sock

[mysqld]
# --- paths / networking ---
datadir         = /home/kimseojin111/.bench/mysqldata
socket          = /home/kimseojin111/.bench/mysqldata/mysqld.sock
pid-file        = /home/kimseojin111/.bench/mysqldata/mysqld.pid
port            = 33061
bind-address    = 127.0.0.1
mysqlx          = OFF                   # no X protocol; save memory/threads under the 1G box
skip-name-resolve                       # no DNS on connect; lower latency, less memory
local_infile    = ON                    # LOAD DATA LOCAL INFILE for fast prefill
mysql_native_password = ON              # 8.4 ships it OFF; enable for sysbench + mysql_async
authentication_policy = mysql_native_password  # default plugin for created users

# --- buffer pool: TUNED = 512M (measured best under the box). The kv dataset is
#     1.6GB on disk, so a 512M pool caches only ~32% -> 0.70 SSD page-reads per
#     lookup (68% miss to SSD): still genuinely SSD-bound, yet best throughput
#     (16.3k ops/s vs 15.1k@256M, 14.6k@128M). With O_DIRECT the pool is the ONLY
#     cache (page cache bypassed for data files), and 512M+overhead fits the 1G
#     cgroup cap without OOM. Larger would risk the cap and cache too much.
innodb_buffer_pool_size    = 512M
innodb_buffer_pool_instances = 4

# --- InnoDB tuned for SSD random reads ---
innodb_flush_method        = O_DIRECT   # no double caching; the 1G cap forces SSD reads
innodb_flush_neighbors     = 0          # SSD: don't flush adjacent pages
innodb_io_capacity         = 2000       # SSD random IOPS
innodb_io_capacity_max     = 4000
innodb_read_io_threads     = 8          # parallel read I/O for random point lookups
innodb_write_io_threads    = 4
innodb_log_file_size       = 256M
innodb_redo_log_capacity   = 512M       # 8.4 name; fewer checkpoints during prefill
innodb_flush_log_at_trx_commit = 2      # benchmark, not durable OLTP
innodb_adaptive_hash_index = ON

# --- connections / threads (2 cores) ---
max_connections            = 256
table_open_cache           = 8000       # avoid table-cache misses under many threads
table_open_cache_instances = 8
tmpdir                     = /home/kimseojin111/.bench/mysqldata
performance_schema         = OFF        # save CPU/memory on the 2-core box

# MySQL 8.4 has no query cache (removed in 8.0) -- nothing to disable.
